{
  "name": "book-walker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test src/lib/reader/view-restore.test.ts src/lib/reader/openlibrary-source.test.ts src/lib/reader/pdf-pages.test.ts src/lib/reader/html.test.ts src/lib/reader/source-id.test.ts src/lib/sources/listing-url.test.ts src/lib/sources/catalog-kind.test.ts src/lib/sources/repair-cover.test.ts src/lib/sources/migrate.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:import-popular": "node scripts/import-popular.mjs",
    "db:import-books": "node scripts/import-books.mjs",
    "db:import-library": "node scripts/import-library.mjs",
    "db:import-pdf": "npx tsx --env-file=.env scripts/import-pdf.mts",
    "db:backfill-publication": "node scripts/backfill-publication-status.mjs",
    "scan:covers": "node scripts/scan-cover-pngs.mjs",
    "repair:covers": "npx tsx --env-file=.env scripts/repair-covers.mts",
    "repair:covers:library": "npx tsx --env-file=.env scripts/repair-covers.mts --library",
    "postinstall": "prisma generate && node scripts/copy-pdf-worker.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@napi-rs/canvas": "^1.0.7",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
