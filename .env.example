# PostgreSQL connection string (use the pooled URL on Vercel if your host provides one)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/book_walker?schema=public"

# Direct (non-pooled) URL used by `prisma migrate deploy`. Same as DATABASE_URL if you are not using a pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/book_walker?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# Public site URL (required in production, e.g. https://your-app.vercel.app)
AUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth (https://github.com/settings/developers)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Comma-separated emails that receive ADMIN role on sign-in
ADMIN_EMAILS="you@example.com"
